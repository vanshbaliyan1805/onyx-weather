# Copy this file to .env (or just export these in your shell) before
# running live (non --demo) fetches that need credentials.
#
# Bluesky, Mastodon, and RSS need NO keys - only Reddit does.

# Reddit: create a free "script" app at https://www.reddit.com/prefs/apps
# (Name: anything. Type: script. redirect uri: http://localhost:8080)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=onyx-weather-pipeline/0.1 by your-reddit-username

# Optional: enable live OpenStreetMap Nominatim geocoding fallback
# (not required - most reports resolve via the built-in city list)
ENABLE_LIVE_GEOCODING=false
