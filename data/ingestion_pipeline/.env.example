# Copy this file to .env (or export these in your shell) before running a
# live fetch that needs credentials.
#
# Open-Meteo, Mastodon, RSS, and Citizen need NO keys at all.
# Only Bluesky needs credentials.

# Bluesky: the PUBLIC search endpoint is broken upstream (403 for everyone),
# so the connector uses an authenticated path instead. You need:
#   1. A free Bluesky account (email only - no phone number required)
#   2. An APP PASSWORD from Settings -> Privacy and Security -> App Passwords
#      (NOT your account password - app passwords are revocable and limited)
BLUESKY_IDENTIFIER=yourhandle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optional: enable live OpenStreetMap Nominatim geocoding fallback
# (not required - most reports resolve via the built-in city list)
ENABLE_LIVE_GEOCODING=false
