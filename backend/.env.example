# ----------------------------------------------------
# DATABASE
# ----------------------------------------------------
# Local Development: 
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/onyx_weather
#
# Production (Supabase):
# Replace [YOUR-PASSWORD] and [YOUR-SUPABASE-DB-URL]. 
# Ensure you keep `postgresql+asyncpg://` as the driver.
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@[YOUR-SUPABASE-DB-URL]:5432/postgres

# ----------------------------------------------------
# API CONFIGURATION
# ----------------------------------------------------
PROJECT_NAME="Onyx Weather Backend"
API_V1_STR="/api/v1"
ADMIN_API_KEY="hackathon-secret-key-change-me"

# ----------------------------------------------------
# CORS
# ----------------------------------------------------
# Comma-separated list of allowed frontend origins.
# Use "*" for hackathon local dev, or the exact Render/Vercel URL in production.
FRONTEND_ORIGINS="*"
